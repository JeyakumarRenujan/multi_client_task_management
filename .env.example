# Me Plus Environment Configuration

# Server Port
PORT=5000

# External Database (MongoDB Atlas or Local MongoDB)
# Leave blank or commented out to use the built-in embedded JSON store (server/data/db.json).
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/meplus?retryWrites=true&w=majority
# MONGODB_URI=mongodb://localhost:27017/meplus

# ---------------------------------------------------------------------------
# Real Email Delivery (SMTP) for Password Reset Verification (OTP)
# ---------------------------------------------------------------------------
# When SMTP_USER and SMTP_PASS are configured, real OTP emails will be sent
# directly to the user's registered email inbox with a branded HTML template.
# If left blank, the platform automatically runs in dev/simulated fallback mode.
#
# Option A: Gmail (Recommended for quick setup)
# 1. Enable 2-Step Verification on your Google Account: https://myaccount.google.com/security
# 2. Generate an App Password (Select 'Mail' / 'Other'): https://myaccount.google.com/apppasswords
# 3. Enter your Gmail and the 16-character App Password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Me Plus Workspace" <noreply@meplus.io>

# Option B: Resend SMTP
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_123456789...

# Option C: Brevo (Sendinblue)
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-brevo-login@domain.com
# SMTP_PASS=your-smtp-master-key
